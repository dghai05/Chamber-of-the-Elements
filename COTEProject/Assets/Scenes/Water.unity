    - target: {fileID: 7737600140885683027, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: m_Name
      value: NPC Variant
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: npcDialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[0]'
      value: "ELDER THEROS: You have endured the weight of stone\u2014now prepare
        to brave the cold stillness of the deep. Poseidon, once the ever-moving tide,
        now lies entombed beneath sheets of ice. His domain has frozen over, gripped
        by a silence not even the sea can break."
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[1]'
      value: 'ELDER THEROS: Erebus has robbed the waters of their rhythm, turning
        waves into jagged walls and currents into traps of frost. Glaciers grind
        through what was once a living sea. You must descend into this frozen abyss
        and awaken the slumbering god beneath the ice.'
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[2]'
      value: "ELDER THEROS: To move through this world of frost and fracture, Poseidon
        grants you his swiftness. Press E to dash\u2014glide like cracking ice across
        a frozen surface, or slip through danger before it closes around you."
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: playerResponsePrompts.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'playerResponsePrompts.Array.data[0]'
      value: "The ocean\u2019s frozen? That\u2019s not just Erebus\u2019s shadow\u2014it\u2019s
        something deeper."
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'playerResponsePrompts.Array.data[1]'
      value: "Then I\u2019ll shatter the stillness. Poseidon will rise again. "
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'playerResponsePrompts.Array.data[2]'
      value: "The cold may bite, but I\u2019ll be faster than the freeze. The sea
        hasn\u2019t lost me yet. "
      objectReference: {fileID: 0}
    - target: {fileID: 8580756411385516203, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: m_LocalPosition.x
      value: -3.8799996
      objectReference: {fileID: 0}
