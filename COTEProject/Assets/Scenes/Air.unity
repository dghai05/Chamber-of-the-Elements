    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 3754736545767124586, guid: 4c587e5d55b6c4b57ab1eb7f8bf1595d, type: 3}
      propertyPath: m_text
      value: "The clouds shift, but they do not carry you.\nUnpredictable paths -
        some swift, some slow.\nMove with them and time each leap with care. \nOnce
        you master the air, beyond you can go."
      objectReference: {fileID: 0}
