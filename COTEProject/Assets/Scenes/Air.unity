      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7737600140885683027, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: m_Name
      value: NPC Variant (1)
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: npcDialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[0]'
      value: "ELDER THEROS: The wind carries whispers of your progress, brave one.
        Vayu\u2019s domain once soared above the clouds, filled with laughter and
        song. Now, only silence remains. "
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[1]'
      value: "ELDER THEROS: Erebus has stolen the skies, and the very air resists
        breath. You must rise through the storms, face illusions and doubt\u2014for
        the mind can falter even when the body stands strong."
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[2]'
      value: "ELDER THEROS: Vayu grants you lightness, a second breath midair. Press
        B to leap higher while airborne\u2014a double jump, born of the wind\u2019s
        grace. "
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: playerResponsePrompts.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'playerResponsePrompts.Array.data[0]'
      value: "Then I\u2019ll break the silence. I\u2019ll bring the wind back to
        life. "
      objectReference: {fileID: 0}
