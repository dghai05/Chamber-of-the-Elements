    - target: {fileID: 5588349825408068422, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7737600140885683027, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: m_Name
      value: NPC Variant
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: npcDialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[0]'
      value: 'ELDER THEROS: This is your final trial. Hephaestus, master of flame
        and forge, once shaped the heart of the world. Now his fires burn unchecked,
        twisted by fury and sorrow. '
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[1]'
      value: 'ELDER THEROS: Erebus has turned his passion into rage. Step into the
        crucible, and let the flame temper you, not consume you. Only through fire
        can your true strength be revealed. '
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'npcDialogueLines.Array.data[2]'
      value: "ELDER THEROS: Hephaestus offers you his fire\u2014not to burn the world,
        but to ignite your strikes with his fury. Hold right-click while attacking
        to channel his power and deliver blows that deal triple damage. But beware\u2014such
        power demands control. "
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: playerResponsePrompts.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'playerResponsePrompts.Array.data[0]'
      value: "Then I\u2019ll temper that fire. I\u2019ll remind him what it means
        to build, not destroy. "
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'playerResponsePrompts.Array.data[1]'
      value: "I\u2019m ready. I\u2019ll emerge stronger\u2014or not at all. "
      objectReference: {fileID: 0}
    - target: {fileID: 8424219675579236305, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: 'playerResponsePrompts.Array.data[2]'
      value: "Then I\u2019ll strike true. Every flame will burn with purpose. "
      objectReference: {fileID: 0}
    - target: {fileID: 8580756411385516203, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
      propertyPath: m_LocalPosition.y
      value: -0.56
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 13c64e802785e4847be9b5d2958a44ee, type: 3}
